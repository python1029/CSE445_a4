<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		   xmlns="https://python1029.github.io/CSE445_a4"
		   targetNamespace="https://python1029.github.io/CSE445_a4"
		   elementFormDefault="qualified"
		   attributeFormDefault="unqualified">
	<!--Root Element-->
	<xs:element name="NationalParks">
		<!-- <xs:annotation>
			<xs:documentation>
				National Parks XML Schema
				The schema defines the structure of the National Parks XML file. 
				It includes elements for Park, Name, Phone, Address, and attributes for NearestAirport and Rating. 
				The schema enforces specific formats for phone numbers, state abbreviations, and zip codes to ensure data consistency.
			</xs:documentation>
		</xs:annotation> -->
		<!--Elements Definition-->
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NationalPark" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Name" type="xs:string" />
									<!--Make sure phone is in format 123-456-7890, there can be many phone numbers-->
							<xs:element name="Phone" minOccurs="1" maxOccurs="unbounded">
								<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:pattern value="[0-9]{3}-[0-9]{3}-[0-9]{4}"/>
								</xs:restriction>
								</xs:simpleType>
							</xs:element>
								<!--Address element contains Number, Street, City, State, and Zip elements-->
							<xs:element name="Address" minOccurs="1" maxOccurs="1">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Number" type ="xs:string" minOccurs="1" maxOccurs="1">
											
											
											
										</xs:element>
										<xs:element name="Street" type="xs:string" minOccurs="1" maxOccurs="1">
										<!--	<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:pattern value="[A-Za-z0-9 ]+([ .'-][A-Za-z0-9]+)*"/>
												</xs:restriction>
											</xs:simpleType> -->
										</xs:element>
										<xs:element name="City" type="xs:string" minOccurs="1" maxOccurs="1">
											<!--	<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:pattern value="[A-Za-z ]+([ .'-][A-Za-z]+)*"/>
												</xs:restriction>
											</xs:simpleType> -->
										</xs:element>
										
										<xs:element name="State" minOccurs="1" maxOccurs="1">
												<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:pattern value="[A-Z]{2}"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="Zip" minOccurs="1" maxOccurs="1">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:pattern value="[0-9]{5}"/>
												</xs:restriction>
											</xs:simpleType> 
										</xs:element>
										
									</xs:sequence>
									<!--Define NearestAirport attribute, it's required-->
									<xs:attribute name="NearestAirport" type="xs:string" use="required">
										
									</xs:attribute>	
								</xs:complexType>
								
							</xs:element>	
						</xs:sequence>
						<!--Define Rating attribute, it's optional-->
						<xs:attribute name="Rating" use="optional">
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:minInclusive value="0.0"/>
									<xs:maxInclusive value="5.0"/>
									<!-- <xs:fractionDigits value="1"/> --> 
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>	
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>